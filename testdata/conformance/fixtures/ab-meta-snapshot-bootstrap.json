{
  "capability_id": "ab-meta-snapshot-bootstrap",
  "description": "验证 AB metadata snapshot 导出格式一致性。",
  "cases": [
    {
      "id": "single-gate-snapshot",
      "spec_file": "gate/public.json"
    },
    {
      "id": "config-with-payloads",
      "spec_file": "config/public.json"
    },
    {
      "id": "multi-gate-specs",
      "spec_file": "gate/complicate.json"
    },
    {
      "id": "missing-project-secret-init-error",
      "operation": "init_client_without_project_secret",
      "languages": ["go", "python", "java"]
    },
    {
      "id": "init-loads-meta-sync-once",
      "operation": "init_client_loads_meta_once",
      "spec_file": "gate/public.json",
      "eval": {
        "user": {
          "login_id": "user-pass",
          "properties": {
            "public": true
          }
        },
        "key": "TestSpec"
      },
      "languages": ["go", "python", "java"]
    },
    {
      "id": "meta-request-includes-sdk-version-header",
      "operation": "meta_request_headers",
      "spec_file": "gate/public.json",
      "allowed_headers": [
        "Authorization",
        "Content-Type",
        "SourceToken",
        "X-SDK",
        "X-SDK-Version",
        "x-auth-nonce",
        "x-auth-timestamp",
        "x-content-sha256"
      ],
      "ignored_transport_headers": [
        "Accept-Encoding",
        "User-Agent"
      ]
    }
  ]
}
